with "config/roguelike_001_config.gpr";
project Roguelike_001 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Roguelike_001_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("roguelike_001.adb");

   package Compiler is
      for Default_Switches ("Ada") use Roguelike_001_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Roguelike_001;
